    "borderSubtle": { "dark": "mudElement", "light": "mudElement" },
    "diffAdded": { "dark": "mossBright", "light": "mossBright" },
    "diffRemoved": { "dark": "amber", "light": "amber" },
    "diffContext": { "dark": "mossDark", "light": "mossDark" },
    "diffHunkHeader": { "dark": "mossDim", "light": "mossDim" },
    "diffHighlightAdded": { "dark": "mossBright", "light": "mossBright" },
    "diffHighlightRemoved": { "dark": "amber", "light": "amber" },
    "diffAddedBg": { "dark": "#0D1D0A", "light": "#0D1D0A" },
    "diffRemovedBg": { "dark": "#1C1608", "light": "#1C1608" },
    "diffContextBg": { "dark": "mudPanel", "light": "mudPanel" },
    "diffLineNumber": { "dark": "mossDark", "light": "mossDark" },
    "diffAddedLineNumberBg": { "dark": "#0A1808", "light": "#0A1808" },
