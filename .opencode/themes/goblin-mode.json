    "markdownLinkText": { "dark": "amber", "light": "amber" },
    "markdownCode": { "dark": "mossBright", "light": "mossBright" },
    "markdownBlockQuote": { "dark": "mossDim", "light": "mossDim" },
    "markdownEmph": { "dark": "mossBright", "light": "mossBright" },
    "markdownStrong": { "dark": "mossBright", "light": "mossBright" },
    "markdownHorizontalRule": { "dark": "mossDark", "light": "mossDark" },
    "markdownListItem": { "dark": "moss", "light": "moss" },
    "markdownListEnumeration": { "dark": "mossDim", "light": "mossDim" },
    "markdownImage": { "dark": "amber", "light": "amber" },
    "markdownImageText": { "dark": "amber", "light": "amber" },
    "markdownCodeBlock": { "dark": "moss", "light": "moss" },
    "syntaxComment": { "dark": "mossDark", "light": "mossDark" },
    "syntaxKeyword": { "dark": "mossBright", "light": "mossBright" },
