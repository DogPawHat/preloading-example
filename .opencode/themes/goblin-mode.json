{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "moss": "#7CFF4F",
    "mossBright": "#B6FF7A",
    "mossDim": "#4D9B33",
    "mossDark": "#24451F",
    "mud": "#0B1208",
    "mudPanel": "#101B0D",
    "mudElement": "#172613",
    "bogBorder": "#2A4A22",
    "amber": "#D7B85A"
  },
  "theme": {
    "primary": { "dark": "moss", "light": "moss" },
    "secondary": { "dark": "mossBright", "light": "mossBright" },
    "accent": { "dark": "amber", "light": "amber" },
    "error": { "dark": "amber", "light": "amber" },
    "warning": { "dark": "amber", "light": "amber" },
    "success": { "dark": "mossBright", "light": "mossBright" },
    "info": { "dark": "moss", "light": "moss" },
    "text": { "dark": "moss", "light": "moss" },
