    "background": { "dark": "mud", "light": "mud" },
    "backgroundPanel": { "dark": "mudPanel", "light": "mudPanel" },
    "backgroundElement": { "dark": "mudElement", "light": "mudElement" },
    "backgroundMenu": { "dark": "mudElement", "light": "mudElement" },
    "selectedListItemText": { "dark": "mud", "light": "mud" },
    "border": { "dark": "bogBorder", "light": "bogBorder" },
